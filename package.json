{
  "name": "notionize",
  "version": "1.0.0",
  "description": "A Notion-like writing experience for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "notion"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
